# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_IDS=123456789
SUPPORT_CONTACT=@your_support
BRAND_NAME=Чест-досье

# Runtime: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite is enough for the concierge MVP. PostgreSQL can replace this URL later.
DATABASE_URL=sqlite+aiosqlite:///./data/chess_dossier.db
STORAGE_ROOT=./data/storage

# Production FSM must use Redis; MemoryStorage is allowed only outside production.
REDIS_URL=

# Payment modes: manual (development only) | telegram_stars
PAYMENT_MODE=manual
STAR_PRICE=0
DISPLAY_PRICE_RUB=990

# Product limits
MAX_DAILY_ORDERS=3
MAX_GAMES_PER_ORDER=50
MAX_UPLOAD_BYTES=20971520
DELIVERY_HOURS=24
BUSINESS_TIMEZONE=Europe/Moscow

# Development convenience. Production must run Alembic explicitly.
AUTO_CREATE_SCHEMA=false

# Automated local core. Docker Compose installs Stockfish and overrides this to true.
ANALYSIS_ENABLED=false
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128
ANALYSIS_FAST_NODES=12000
ANALYSIS_DEEP_NODES=180000
ANALYSIS_CANDIDATE_LOSS_CP=120
ANALYSIS_MAX_CRITICAL_POSITIONS=64
ANALYSIS_MAX_CONVERSION_POSITIONS=20
ANALYSIS_WORKER_POLL_SECONDS=10
LICHESS_BASE_URL=https://lichess.org
LICHESS_API_TOKEN=
